# Caminho do arquivo SQLite. Default: ./data/app-dnd.sqlite
APP_DND_DB=./data/app-dnd.sqlite

# Porta/interface do servidor (default 8080 / 0.0.0.0). Atrás do nginx, use HOST=127.0.0.1.
PORT=8080
HOST=0.0.0.0

# PINs (defaults iguais aos de CHARACTER_PINS.md). Sobrescreva em produção se quiser.
# APP_DND_MASTER_PIN=670076
# APP_DND_CHARACTER_PINS=joao-lindao:7429,camargo-fofo:3816,vinicius-fofo:9052,ruda-felpudo:6148
