{
  "name": "app-dnd",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "build:web": "vite build && bun scripts/precompress.mjs dist",
    "build:server": "cargo build --release --manifest-path server/Cargo.toml",
    "build": "bun run build:web && bun run build:server",
    "start": "server/target/release/app-dnd",
    "seed:export": "bun scripts/export-seed.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:server": "cargo test --manifest-path server/Cargo.toml",
    "test:smoke": "bun scripts/smoke-http.mjs",
    "test:all": "bun run lint && bun run typecheck && bun run test && bun run test:server && bun run build && bun run test:smoke"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.9.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7.0.0"
  }
}
