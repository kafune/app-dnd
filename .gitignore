# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage


# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# SQLite data (ficha persistida em runtime)
/data
*.sqlite
*.sqlite-shm
*.sqlite-wal

# vercel
.vercel

# typescript
*.tsbuildinfo

# frontend buildado (embutido no binário Rust) e artefatos do cargo
/dist
/server/target

# estado do scripts/deploy-vps.sh (deploy anterior, backups)
/.deploy
/backup

# livros/manuais em PDF (fonte de consulta local, não versionar)
*.pdf
